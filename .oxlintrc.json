{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "overrides": [
    {
      "files": ["src/components/react-bits/**"],
      "rules": {
        "react/refs": "off",
        "react/hooks": "off",
        "react/exhaustive-effect-dependencies": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    "build",
    "src/mygo.ts"
  ]
}
